---
// Hero.astro — titular gigante; al scrollear las líneas se separan hacia los costados
import { site } from "../data/portfolio";

const lines = [
  { t: "Construyo", dir: -1 },
  { t: "lo que parece", dir: 1 },
  { t: "imposible.", dir: -1, accent: true },
];
---

<section id="top" data-scrub="exit" data-nav-label="Inicio" class="hero relative flex min-h-[100svh] flex-col justify-between overflow-hidden pb-10 pt-28">
  <div class="wrap flex items-start justify-between gap-6">
    <p class="label" data-reveal>Ingeniería · Seguridad · IA · Producto</p>
    <p class="label hidden text-right sm:block" data-reveal style="--d:.1s">Buenos Aires, AR<br />Disponible para proyectos</p>
  </div>

  <h1 class="wrap display text-[clamp(3.4rem,11.5vw,12.5rem)]" aria-label="Construyo lo que parece imposible.">
    {
      lines.map((l, i) => (
        <span class="line block overflow-hidden" style={`--dir:${l.dir}`} aria-hidden="true">
          <span class={`inner block ${l.accent ? "text-mute" : ""}`} style={`--d:${0.08 * i}s`}>{l.t}</span>
        </span>
      ))
    }
  </h1>

  <div class="wrap grid gap-8 border-t border-rule pt-6 md:grid-cols-[1fr_1.4fr_auto] md:items-end">
    <p class="text-lg font-semibold tracking-tight" data-reveal>{site.name}</p>
    <p class="lede max-w-xl" data-reveal style="--d:.1s">
      Del kernel de Linux a la criptografía en producción, pasando por IA generativa 3D que corre en mi
      propio hardware. De punta a punta, y terminado.
    </p>
    <a href="#index" class="label flex items-center gap-3 !text-ink" data-reveal style="--d:.2s">
      Ver proyectos
      <span class="cue grid h-9 w-9 place-items-center rounded-full border border-rule">↓</span>
    </a>
  </div>
</section>

<style>
  /* entrada: cada línea sube desde abajo de su máscara */
  .js-motion .inner { transform: translateY(105%); }
  .js-motion .is-in .inner { transform: none; transition: transform 1.3s var(--ease-out-expo) var(--d); }
  /* salida con scroll: las líneas se abren hacia los costados */
  .line { transform: translateX(calc(var(--dir) * var(--p, 0) * 22vw)); opacity: calc(1 - var(--p, 0) * 1.2); }
  .cue { animation: bob 2.4s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(4px); } }
</style>
