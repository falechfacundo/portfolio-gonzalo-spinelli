---
// SocialLinks.astro — íconos de GitHub/LinkedIn; solo muestra los que están cargados en site
import GitHubIcon from "./icons/GitHubIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";
import { site } from "../data/portfolio";

const { class: cls = "", variant = "icon" } = Astro.props as { class?: string; variant?: "icon" | "button" };
const links = [
  { href: site.github, label: "GitHub", Icon: GitHubIcon },
  { href: site.linkedin, label: "LinkedIn", Icon: LinkedInIcon },
].filter((l) => l.href);
---

{
  links.length > 0 && (
    <div class={`flex items-center gap-1 ${cls}`}>
      {links.map(({ href, label, Icon }) =>
        variant === "button" ? (
          <a href={href} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm" data-magnetic>
            <Icon class="h-4 w-4" /> {label}
          </a>
        ) : (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            title={label}
            class="grid h-12 w-12 place-items-center rounded-full text-fg-2 transition-colors hover:bg-white/10 hover:text-white"
            data-magnetic
          >
            <Icon class="h-6 w-6" />
          </a>
        ),
      )}
    </div>
  )
}
