---
// ProjectMedia.astro — elige el showcase animado según el variant del proyecto.
// Cada showcase se anima con CSS mientras su contenedor tiene .is-on (lo pone Projects.astro).
import type { Project } from "../data/portfolio";
import Model3D from "./showcases/Model3D.astro";
import Kernel from "./showcases/Kernel.astro";
import QrDoorbell from "./showcases/QrDoorbell.astro";
import Clinic from "./showcases/Clinic.astro";
import Shop from "./showcases/Shop.astro";
import Dashboard from "./showcases/Dashboard.astro";
import Recommender from "./showcases/Recommender.astro";

interface Props {
  p: Project;
}
const { p } = Astro.props;
const map = {
  model3d: Model3D,
  kernel: Kernel,
  qr: QrDoorbell,
  clinic: Clinic,
  shop: Shop,
  dashboard: Dashboard,
  recommender: Recommender,
};
const Showcase = map[p.variant];
---

<div class="showcase relative aspect-[16/10] h-full w-full overflow-hidden rounded-[1.2rem] ring-1 ring-line">
  <div class="sc-root"><Showcase p={p} /></div>
</div>

<style>
  /* todo el contenido de los showcases usa em: escala con el ancho del marco */
  .showcase { container-type: inline-size; }
  .sc-root { position: absolute; inset: 0; font-size: clamp(15px, 3.4cqw, 24px); }
</style>
