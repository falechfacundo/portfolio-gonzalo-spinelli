---
import NestJSIcon from "./icons/NestJSIcon.astro";
import ClaudeIcon from "./icons/ClaudeIcon.astro";
import ChatGPTIcon from "./icons/ChatGPTIcon.astro";
import CloudflareWorkersIcon from "./icons/CloudflareWorkersIcon.astro";
import DeepSeekIcon from "./icons/DeepSeekIcon.astro";
import ExpressIcon from "./icons/ExpressIcon.astro";
import CursorIcon from "./icons/CursorIcon.astro";
import ClerkIcon from "./icons/ClerkIcon.astro";
import FigmaIcon from "./icons/FigmaIcon.astro";
import WordpressIcon from "./icons/WordpressIcon.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
import GoogleMapsIcon from "./icons/GoogleMapsIcon.astro";
import JavaScriptIcon from "./icons/JavaScriptIcon.astro";
import JsonIcon from "./icons/JsonIcon.astro";
import JWTIcon from "./icons/JWTIcon.astro";
import ModelContextProtocolIcon from "./icons/ModelContextProtocolIcon.astro";
import TursoIcon from "./icons/TursoIcon.astro";
import NeonIcon from "./icons/NeonIcon.astro";
import NextJSIcon from "./icons/NextJSIcon.astro";
import PythonIcon from "./icons/PythonIcon.astro";
import ReactIcon from "./icons/ReactIcon.astro";
import ReactRouterIcon from "./icons/ReactRouterIcon.astro";
import StrapiIcon from "./icons/StrapiIcon.astro";
import StripeIcon from "./icons/StripeIcon.astro";
import SupabaseIcon from "./icons/SupabaseIcon.astro";
import TailwindCSSIcon from "./icons/TailwindCSSIcon.astro";
import VercelIcon from "./icons/VercelIcon.astro";
import TypeScriptIcon from "./icons/TypeScriptIcon.astro";
import UIIcon from "./icons/UIIcon.astro";
import N8nIcon from "./icons/N8nIcon.astro";
import VSCodeIcon from "./icons/VSCodeIcon.astro";
import GithubCopilotIcon from "./icons/GithubCopilotIcon.astro";
import MercadoPagoIcon from "./icons/MercadoPagoIcon.astro";
import HTMLIcon from "./icons/HTMLIcon.astro";
import CSSIcon from "./icons/CSSIcon.astro";
import ShadcnUiIcon from "./icons/ShadcnUiIcon.astro";
import MarkdownIcon from "./icons/MarkdownIcon.astro";
import ResendIcon from "./icons/ResendIcon.astro";
import ZodIcon from "./icons/ZodIcon.astro";
import CloudflareIcon from "./icons/CloudflareIcon.astro";
import MongoDBIcon from "./icons/MongoDBIcon.astro";
import ESLintIcon from "./icons/ESLintIcon.astro";
import RailwayIcon from "./icons/RailwayIcon.astro";
import AstroIcon from "./icons/AstroIcon.astro";
import DockerIcon from "./icons/DockerIcon.astro";
import MySQLIcon from "./icons/MySQLIcon.astro";
import PostgreSQLIcon from "./icons/PostgreSQLIcon.astro";
import GitIcon from "./icons/GitIcon.astro";
import ChartJSIcon from "./icons/ChartJSIcon.astro";
import BashIcon from "./icons/BashIcon.astro";
import JestIcon from "./icons/JestIcon.astro";
import PrismaIcon from "./icons/PrismaIcon.astro";
import SublimeTextIcon from "./icons/SublimeTextIcon.astro";

import { projects } from "../data/portfolio";

// Bento por área. TODO: ajustar con las herramientas que Gonzalo usa de verdad.
const areas = [
  {
    title: "IA",
    span: "lg:col-span-4",
    items: [
      { Icon: ClaudeIcon, label: "Claude Code" },
      { Icon: ChatGPTIcon, label: "ChatGPT" },
      { Icon: CursorIcon, label: "Cursor" },
      { Icon: GithubCopilotIcon, label: "Github Copilot" },
      { Icon: ModelContextProtocolIcon, label: "MCP" },
    ],
  },
  {
    title: "Web",
    span: "lg:col-span-2",
    items: [
      { Icon: HTMLIcon, label: "HTML" },
      { Icon: CSSIcon, label: "CSS" },
      { Icon: JavaScriptIcon, label: "JavaScript" },
      { Icon: ReactIcon, label: "React" },
      { Icon: TailwindCSSIcon, label: "Tailwind CSS" },
    ],
  },
  {
    title: "Deploy y datos",
    span: "lg:col-span-2",
    items: [
      { Icon: VercelIcon, label: "Vercel" },
      { Icon: SupabaseIcon, label: "Supabase" },
      { Icon: GitIcon, label: "Git" },
      { Icon: GitHubIcon, label: "GitHub" },
    ],
  },
];

const others = [
  { Icon: NextJSIcon, label: "Next.js" },
  { Icon: TypeScriptIcon, label: "TypeScript" },
  { Icon: PythonIcon, label: "Python" },
  { Icon: VSCodeIcon, label: "VS Code" },
  { Icon: FigmaIcon, label: "Figma" },
  { Icon: StripeIcon, label: "Stripe" },
  { Icon: MercadoPagoIcon, label: "Mercado Pago" },
  { Icon: ChartJSIcon, label: "Chart.js" },
];

// cruza cada label con los tags de los proyectos: "Next.js 16" → "next.js", "Tailwind CSS" → "tailwind"
const aliases: Record<string, string> = { "tailwind css": "tailwind", "shadcn ui": "shadcn" };
const norm = (t: string) => {
  const k = t.toLowerCase().replace(/\s+v?\d+(\.\d+)*$/, "").trim();
  return aliases[k] ?? k;
};
const sources = projects.map((p) => ({ title: p.title, tags: p.tags }));
const usage: Record<string, string[]> = Object.fromEntries(
  areas
    .flatMap((a) => a.items)
    .map(({ label }) => [label, sources.filter((s) => s.tags.some((t) => norm(t) === norm(label))).map((s) => s.title)]),
);
const first = "Claude Code";
---

<section id="skills" class="section">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-full"
    aria-hidden="true"
  >
    <div class="absolute left-[-10%] top-1/4 h-[40vmin] w-[40vmin] rounded-full bg-sky-500/10 blur-[120px]"></div>
  </div>
  <div class="wrap">
    <span class="eyebrow" data-reveal>Skills</span>
    <h2 class="h-section mt-5 max-w-3xl" data-reveal>
      Mi caja de <span class="grad-accent">herramientas</span>.
    </h2>
    <p class="lead mb-14 mt-6 max-w-2xl" data-reveal>
      Lo que uso a diario, agrupado por área. Elegí una tecnología para ver en qué proyectos la usé.
    </p>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-6" data-skills data-usage={JSON.stringify(usage)}>
      {
        areas.map((area) => (
          <div class={`spot glass rounded-3xl p-6 ${area.span}`} data-reveal>
            <h3 class="mb-5 font-mono text-[0.75rem] uppercase tracking-[0.14em] text-accent-2">{area.title}</h3>
            <div class="grid grid-cols-3 gap-2 sm:grid-cols-5">
              {area.items.map(({ Icon, label }) => (
                <button
                  type="button"
                  data-skill={label}
                  aria-pressed={label === first ? "true" : "false"}
                  class="skill flex flex-col items-center rounded-xl p-2 transition duration-500"
                >
                  <Icon width="42" height="42" />
                  <span class="mt-2 text-center text-[0.78rem] text-fg-2">{label}</span>
                </button>
              ))}
            </div>
          </div>
        ))
      }

      <aside
        class="usage glass order-first rounded-3xl p-5 lg:order-none lg:col-span-2 lg:col-start-5 lg:row-span-2 lg:row-start-1 lg:p-6"
        aria-live="polite"
      >
        <h3 class="font-mono text-[0.75rem] uppercase tracking-[0.14em] text-accent-2">Dónde la usé</h3>
        <p class="mt-3 text-2xl font-semibold tracking-tight text-white" data-skill-name>{first}</p>
        <ul class="mt-4 flex flex-wrap gap-2" data-skill-list>
          {usage[first].map((t) => <li class="chip">{t}</li>)}
        </ul>
      </aside>

      <div class="spot glass rounded-3xl p-6 lg:col-span-6" data-reveal>
        <h3 class="mb-5 font-mono text-[0.75rem] uppercase tracking-[0.14em] text-accent-2">He trabajado con</h3>
        <ul class="flex flex-wrap gap-2">
          {others.map(({ Icon, label }) => (
            <li class="chip">
              <Icon width="18" height="18" />
              {label}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .skill[aria-pressed="true"] {
    background: rgba(155, 139, 255, 0.12);
    box-shadow: inset 0 0 0 1px rgba(155, 139, 255, 0.55);
  }
  @media (hover: hover) {
    .skill:hover { transform: translateY(-4px); background-color: rgba(255, 255, 255, 0.05); }
  }
  .skill:focus-visible { outline: 2px solid var(--color-accent-2); outline-offset: 2px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-skills]").forEach((root) => {
    const usage: Record<string, string[]> = JSON.parse(root.dataset.usage ?? "{}");
    const name = root.querySelector<HTMLElement>("[data-skill-name]")!;
    const list = root.querySelector<HTMLElement>("[data-skill-list]")!;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-skill]"));
    const show = (btn: HTMLButtonElement) => {
      const label = btn.dataset.skill!;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      name.textContent = label;
      const items = usage[label]?.length ? usage[label] : ["Parte de mi flujo de trabajo"];
      list.replaceChildren(
        ...items.map((t) => {
          const li = document.createElement("li");
          li.className = "chip";
          li.textContent = t;
          return li;
        }),
      );
    };
    const hover = matchMedia("(hover: hover)").matches;
    buttons.forEach((b) => {
      b.addEventListener("click", () => show(b));
      b.addEventListener("focus", () => show(b));
      if (hover) b.addEventListener("pointerenter", () => show(b));
    });
  });
</script>
