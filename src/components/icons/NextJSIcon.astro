---
interface Props {
  class?: string;
  width?: string;
  height?: string;
}

const { class: className = "", width = "24", height = "24" } = Astro.props;
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox="0 0 180 180"
  fill="none"
  {...Astro.props}
>
  <defs>
    <mask id="nextjs_icon_dark__a" x="0" y="0" maskUnits="userSpaceOnUse">
      <circle cx="90" cy="90" r="87" fill="#fff"></circle>
    </mask>
    <linearGradient
      id="nextjs_icon_dark__b"
      x1="90"
      y1="54"
      x2="90"
      y2="125.97"
    >
      <stop stop-color="#fff"></stop>
    </linearGradient>
    <linearGradient
      id="nextjs_icon_dark__c"
      x1="115"
      y1="54"
      x2="115"
      y2="125.97"
    >
      <stop stop-color="#fff"></stop>
    </linearGradient>
  </defs>
  <g mask="url(#nextjs_icon_dark__a)">
    <circle cx="90" cy="90" r="87" fill="black" stroke="white" stroke-width="6"
    ></circle>
    <path
      d="M149.508 157.52L69.142 54H54V125.97H66.1136V69.3836L139.999 164.845C143.333 162.614 146.509 160.165 149.508 157.52Z"
      fill="url(#nextjs_icon_dark__b)"></path>
    <rect x="115" y="54" width="12" height="72" fill="url(#nextjs_icon_dark__c)"
    ></rect>
  </g>
</svg>
