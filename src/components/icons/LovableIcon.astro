---
interface Props {
  class?: string;
  width?: string;
  height?: string;
}

const { class: className = "", width = "24", height = "24" } = Astro.props;
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox="0 0 121 122"
  fill="none"
  {...Astro.props}
>
  <defs>
    <mask id="lovable__b" x="0" y="0" maskUnits="userSpaceOnUse">
      <rect x="0" y="0" width="121" height="122" fill="#fff"></rect>
    </mask>
    <filter id="lovable__c">
      <feGaussianBlur stdDeviation="25"></feGaussianBlur>
    </filter>
    <filter id="lovable__d">
      <feGaussianBlur stdDeviation="25"></feGaussianBlur>
    </filter>
    <filter id="lovable__e">
      <feGaussianBlur stdDeviation="25"></feGaussianBlur>
    </filter>
    <filter id="lovable__f">
      <feGaussianBlur stdDeviation="25"></feGaussianBlur>
    </filter>
  </defs>
  <g mask="url(#lovable__b)">
    <g filter="url(#lovable__c)">
      <ellipse cx="52.738" cy="65.101" fill="#4B73FF" rx="81.373" ry="81.192"
      ></ellipse>
    </g>
    <g filter="url(#lovable__d)">
      <ellipse cx="61.673" cy="20.547" fill="#FF66F4" rx="104.216" ry="81.192"
      ></ellipse>
    </g>
    <g filter="url(#lovable__e)">
      <ellipse cx="78.666" cy="5.268" fill="#FF0105" rx="81.373" ry="71.304"
      ></ellipse>
    </g>
    <g filter="url(#lovable__f)">
      <ellipse cx="63.121" cy="20.527" fill="#FE7B02" rx="48.937" ry="48.829"
      ></ellipse>
    </g>
  </g>
</svg>
