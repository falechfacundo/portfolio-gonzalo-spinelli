---
// Catalog.astro — una grilla de 1.400 mini-productos que hace zoom hasta quedar en uno solo,
// que después cambia de variante
const swatches = ["#1d1d1f", "#b08d57", "#5e7a8a"];
---

<div class="cat">
  <div class="tiles"></div>
  <div class="count"><b>1.400</b> productos activos</div>

  <div class="product">
    <div class="img"><span class="bag"></span></div>
    <div class="meta">
      <span class="lab">Valijas · Cabina</span>
      <strong>Valija rígida 20"</strong>
      <span class="price"><s>$189.900</s> $149.900</span>
      <div class="sw">{swatches.map((c, i) => <i style={`background:${c};--i:${i}`} />)}</div>
    </div>
  </div>
</div>

<style>
  .cat { position: absolute; inset: 0; overflow: hidden; background: #fff; }
  /* 40 x 35 = 1.400 celdas dibujadas con gradientes, sin 1.400 nodos */
  .tiles {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, #fff 1.5px, transparent 1.5px) 0 0 / calc(100% / 40) 100%,
      linear-gradient(#fff 1.5px, transparent 1.5px) 0 0 / 100% calc(100% / 35),
      linear-gradient(135deg, #e8e8ed, #d2d2d7);
    transform-origin: 56% 47%;
    transform: scale(calc(1 + pow(clamp(0, var(--p) * 1.6, 1), 3) * 40));
    opacity: calc(1 - clamp(0, (var(--p) - 0.5) * 6, 1));
  }
  .count { position: absolute; left: 1.4em; top: 1.2em; padding: 0.5em 0.9em; border-radius: 99px; background: #0a0a0a; color: #fff; font-size: 0.75em; opacity: calc(1 - clamp(0, (var(--p) - 0.25) * 8, 1)); }
  .count b { font-weight: 600; }

  .product { position: absolute; inset: 0; display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 1.6em; padding: 2em; opacity: clamp(0, (var(--p) - 0.5) * 6, 1); transform: scale(calc(0.94 + clamp(0, (var(--p) - 0.5) * 6, 1) * 0.06)); }
  .img { aspect-ratio: 1; border-radius: 1em; background: var(--color-soft); display: grid; place-items: center; }
  .bag { width: 46%; height: 64%; border-radius: 0.8em; background: var(--c, #1d1d1f); box-shadow: inset -0.6em 0 0 rgba(255, 255, 255, 0.06), 0 1.6em 2em -1.2em rgba(0, 0, 0, 0.4); position: relative; transition: background 0.5s; }
  .bag::before { content: ""; position: absolute; left: 30%; right: 30%; top: -14%; height: 14%; border: 0.3em solid #3a3a3c; border-bottom: 0; border-radius: 0.4em 0.4em 0 0; }
  .meta { display: flex; flex-direction: column; gap: 0.5em; }
  .lab { font: 0.6em var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-mute); }
  .meta strong { font-size: 1.3em; letter-spacing: -0.02em; }
  .price { font-size: 0.85em; }
  .price s { color: var(--color-faint); margin-right: 0.4em; }
  .sw { display: flex; gap: 0.5em; margin-top: 0.4em; }
  .sw i { width: 1.4em; height: 1.4em; border-radius: 50%; box-shadow: 0 0 0 2px #fff, 0 0 0 3px transparent; transition: box-shadow 0.3s; }

  /* la variante activa cambia con los pasos finales del scroll */
  :global([data-step="7"]) .bag { --c: #1d1d1f; }
  :global([data-step="8"]) .bag { --c: #b08d57; }
  :global([data-step="9"]) .bag, :global([data-step="10"]) .bag { --c: #5e7a8a; }
  :global([data-step="7"]) .sw i:nth-child(1),
  :global([data-step="8"]) .sw i:nth-child(2),
  :global([data-step="9"]) .sw i:nth-child(3),
  :global([data-step="10"]) .sw i:nth-child(3) { box-shadow: 0 0 0 2px #fff, 0 0 0 3px #0a0a0a; }
</style>
