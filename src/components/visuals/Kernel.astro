---
// Kernel.astro — el log de compilación avanza con el scroll, falla en TrustZone (glitch)
// y se ilumina la cadena de arranque hasta llegar al root
const log: [string, string][] = [
  ["ok", "make ARCH=arm64 samsung_defconfig"],
  ["ok", "CC  drivers/net/wireless/ath9k_htc"],
  ["ok", "LD  vmlinux → Image.gz-dtb"],
  ["err", "boot: verificación fallida · TrustZone"],
  ["dim", "› analizando last_kmsg"],
  ["dim", "› clave de cifrado atada al arranque"],
  ["ok", "drivers built-in · sin módulos firmados"],
  ["ok", "kernel 4.14-nethunter · arrancó"],
];
const chain = ["Bootloader", "Kernel", "TrustZone", "NetHunter"];
---

<div class="kn">
  <div class="term">
    <div class="bar"><i></i><i></i><i></i><span>build.log</span></div>
    {
      log.map(([k, t], i) => (
        <div class={`ln ${k}`} style={`--a:${0.04 + i * 0.075}`}>
          <b>{k === "err" ? "✗" : k === "ok" ? "✓" : " "}</b>{t}
        </div>
      ))
    }
    <div class="ln root" style="--a:0.7">root@nethunter:~# <span class="cur">▍</span></div>
  </div>

  <ol class="chain">
    {
      chain.map((c, i) => (
        <li style={`--a:${0.55 + i * 0.08}`}>
          <span class="dot" />
          <span>{c}</span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .kn {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 1.4em;
    padding: 1.6em;
    background: #050505;
    color: #a1a1a6;
  }
  .term { align-self: center; border: 1px solid #232326; border-radius: 0.8em; padding: 0.9em 1em 1.1em; font: 0.62em/1.85 var(--font-mono); background: #0b0b0c; }
  .bar { display: flex; align-items: center; gap: 0.4em; margin-bottom: 0.8em; color: #5a5a5f; }
  .bar i { width: 0.7em; height: 0.7em; border-radius: 50%; background: #2c2c2e; }
  .bar span { margin-left: 0.6em; }
  .ln { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: clamp(0, (var(--p) - var(--a)) * 30, 1); }
  .ln b { display: inline-block; width: 1.4em; font-weight: 400; }
  .ok b, .root { color: #30d158; }
  .err { color: #ff453a; }
  .dim { color: #636366; }
  .cur { animation: blink 1s step-end infinite; }

  /* el glitch dura lo que el scroll se queda en el paso del error */
  :global([data-step="3"]) .term { animation: glitch 0.22s steps(2) infinite; border-color: #ff453a; }

  .chain { align-self: center; position: relative; margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 1.6em; font: 600 0.8em var(--font-sans); color: #f5f5f7; }
  .chain::before { content: ""; position: absolute; left: 0.45em; top: 0.6em; bottom: 0.6em; width: 1px; background: #2c2c2e; }
  .chain::after { content: ""; position: absolute; left: 0.45em; top: 0.6em; width: 1px; height: calc(clamp(0, (var(--p) - 0.55) * 3.4, 1) * (100% - 1.2em)); background: #ff4f17; }
  .chain li { position: relative; display: flex; align-items: center; gap: 1em; opacity: calc(0.3 + 0.7 * clamp(0, (var(--p) - var(--a)) * 20, 1)); }
  .dot { width: 0.9em; height: 0.9em; border-radius: 50%; border: 1px solid #3a3a3c; background: #050505; z-index: 1; }
  .chain li .dot { box-shadow: 0 0 0 calc(clamp(0, (var(--p) - var(--a)) * 20, 1) * 4px) rgba(255, 79, 23, 0.25); background: rgba(255, 79, 23, clamp(0, (var(--p) - var(--a)) * 20, 1)); }

  @keyframes glitch { 0% { transform: translate(2px, -1px); } 100% { transform: translate(-2px, 1px); } }
  @keyframes blink { 50% { opacity: 0; } }
</style>
