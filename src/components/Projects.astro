---
// Projects.astro — caso de estudio con scroll: el texto avanza y la imagen de la derecha queda fija
import GitHubIcon from "./icons/GitHubIcon.astro";
import ArrowTopLeft from "./ArrowTopLeft.astro";
import Media from "./ProjectMedia.astro";
import { projects, wip } from "../data/portfolio";

const isGithub = (u: string) => u.includes("github.com");
const total = String(projects.length).padStart(2, "0");
const items = projects.map((p, i) => ({
  ...p,
  i,
  n: String(i + 1).padStart(2, "0"),
  lives: p.links.filter((l) => !isGithub(l.href)),
  repos: p.links.filter((l) => isGithub(l.href)),
}));
---

<section id="projects" class="section">
  <div class="wrap">
    <span class="eyebrow" data-reveal>Proyectos</span>
    <h2 class="h-section mt-5 max-w-4xl" data-reveal>
      Cosas que parecen imposibles, <span class="grad-accent">terminadas</span>.
    </h2>
    <p class="lead mt-6 max-w-2xl" data-reveal>
      Del kernel de un teléfono a un jefe de Elden Ring, pasando por criptografía en
      producción. Todo llegó a manos de gente real.
    </p>

    <div class="mt-16 lg:grid lg:grid-cols-[1fr_1.15fr] lg:gap-14" data-cases>
      <div>
        {
          items.map(({ i, n, lives, repos, ...p }) => (
            <article data-case={i} class="case py-10 first:pt-0 lg:flex lg:min-h-[min(78vh,52rem)] lg:portrait:min-h-0 lg:flex-col lg:justify-center lg:py-16">
              <div class="spot noise glass mb-8 rounded-[1.6rem] p-2 lg:hidden" data-case-mobile>
                <Media p={p} />
              </div>

              <span class="font-mono text-xs text-accent-2">
                {n} / {total}
                {p.kicker && <span class="text-fg-3"> · {p.kicker}</span>}
              </span>
              <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{p.title}</h3>

              {p.tagline && <p class="mt-4 text-lg leading-snug text-fg-2">{p.tagline}</p>}

              <ol class="mt-6 space-y-5 border-l border-line pl-5">
                <li>
                  <span class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-fg-3">Qué es</span>
                  <p class="mt-1.5 text-[0.95rem] leading-relaxed text-fg-2">{p.desc}</p>
                </li>
                {p.highlights && (
                  <li>
                    <span class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-fg-3">Lo técnico</span>
                    <ul class="mt-1.5 space-y-1.5">
                      {p.highlights.map((h) => (
                        <li class="flex gap-2 text-[0.95rem] leading-relaxed text-white"><span class="text-accent-2">→</span><span>{h}</span></li>
                      ))}
                    </ul>
                  </li>
                )}
                <li>
                  <span class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-fg-3">Stack</span>
                  <div class="mt-2 flex flex-wrap gap-2">
                    {p.tags.map((t) => <span class="chip">{t}</span>)}
                  </div>
                </li>
              </ol>

              {(lives.length > 0 || repos.length > 0) && (
                <div class="mt-8 flex flex-wrap gap-3">
                  {lives.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm" data-magnetic>
                      {l.label ?? "Ver sitio"} <ArrowTopLeft width="16" height="16" />
                    </a>
                  ))}
                  {repos.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm" data-magnetic>
                      <GitHubIcon class="h-4 w-4" /> {l.label ?? "Código"}
                    </a>
                  ))}
                </div>
              )}
              {p.privateCode && (
                <p class="mt-4 font-mono text-xs text-fg-3">
                  Código privado · disponible a pedido.
                </p>
              )}
            </article>
          ))
        }
      </div>

      <!-- desktop: un solo marco fijo; cambia de proyecto según cuál está en el centro de la pantalla -->
      <div class="hidden lg:block" aria-hidden="true">
        <div class="sticky top-[calc(50vh-15rem)]">
          <div class="spot noise glass rounded-[2rem] p-3">
            <div class="relative aspect-[16/11] overflow-hidden rounded-[1.5rem] bg-base/70">
              {
                items.map(({ i, ...p }) => (
                  <div data-case-media={i} class={`case-media absolute inset-0 p-2 ${i === 0 ? "is-on" : ""}`}>
                    <Media p={p} />
                  </div>
                ))
              }
            </div>
          </div>
          <div class="mt-5 flex items-center gap-2" data-case-dots>
            {items.map(({ i }) => <span data-case-dot={i} class={`case-dot ${i === 0 ? "is-on" : ""}`} />)}
          </div>
        </div>
      </div>
    </div>

    {
      wip.length > 0 && (
        <div class="mt-20" data-reveal>
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-fg-3">También en curso</span>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            {wip.map((w) => (
              <article class="glass rounded-3xl p-6">
                <h3 class="text-lg font-semibold tracking-tight text-white">{w.title}</h3>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-fg-2">{w.desc}</p>
              </article>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-cases]").forEach((root) => {
    const media = Array.from(root.querySelectorAll<HTMLElement>("[data-case-media]"));
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-case-dot]"));
    const set = (i: string) => {
      media.forEach((m) => m.classList.toggle("is-on", m.dataset.caseMedia === i));
      dots.forEach((d) => d.classList.toggle("is-on", d.dataset.caseDot === i));
    };
    // franja central de la pantalla: el caso que la cruza es el activo
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && set((e.target as HTMLElement).dataset.case!)),
      { rootMargin: "-45% 0px -45% 0px" },
    );
    root.querySelectorAll("[data-case]").forEach((c) => io.observe(c));
    // mobile: cada showcase arranca su animación al entrar en pantalla
    const mio = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle("is-on", e.isIntersecting)),
      { threshold: 0.4 },
    );
    root.querySelectorAll("[data-case-mobile]").forEach((m) => mio.observe(m));
  });
</script>

<style>
  .case + .case { border-top: 1px solid var(--color-line); }
  @media (min-width: 64rem) {
    .case + .case { border-top: 0; }
  }
  .case-media {
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0.7s var(--ease-soft, ease), transform 0.9s var(--ease-soft, ease);
  }
  .case-media.is-on { opacity: 1; transform: none; }
  .case-dot {
    height: 4px;
    width: 1.25rem;
    border-radius: 999px;
    background: var(--color-line-strong);
    transition: width 0.5s var(--ease-soft, ease), background 0.5s;
  }
  .case-dot.is-on { width: 2.5rem; background: var(--color-accent-2); }
</style>
