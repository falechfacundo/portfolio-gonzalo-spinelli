---
// Contact.astro — email gigante como llamado a la acción; el formulario aparece solo con endpoint de Formspree
import { site } from "../data/portfolio";
---

<section id="contact" data-nav-label="Contacto" class="py-28 sm:py-40">
  <div class="wrap">
    <p class="label" data-reveal>Contacto</p>
    <h2 class="headline mt-6 max-w-4xl" data-reveal style="--d:.05s">¿Tenés algo que parece imposible?<br /><span class="text-mute">Hablemos.</span></h2>

    <a href={`mailto:${site.email}`} class="mail display mt-16 inline-block break-all text-[clamp(1.9rem,6.4vw,6.6rem)]" data-reveal style="--d:.1s">
      {site.email}
    </a>

    {
      site.formspree && (
        <form id="contactForm" action={site.formspree} method="POST" class="mt-20 grid max-w-3xl gap-8 sm:grid-cols-2" data-reveal>
          <label class="field-wrap"><span class="label">Nombre</span><input name="name" required class="field" /></label>
          <label class="field-wrap"><span class="label">Email</span><input type="email" name="email" required class="field" /></label>
          <label class="field-wrap sm:col-span-2"><span class="label">Mensaje</span><textarea name="message" rows="3" required class="field resize-none" data-lenis-prevent /></label>
          <div class="flex items-center gap-6 sm:col-span-2">
            <button type="submit" class="btn">Enviar</button>
            <p id="formStatus" role="status" class="text-sm text-mute"></p>
          </div>
        </form>
      )
    }
  </div>
</section>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement | null;
  const status = document.getElementById("formStatus");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (status) status.textContent = "Enviando…";
    try {
      const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      if (status) status.textContent = "Mensaje enviado. Te respondo pronto.";
    } catch {
      if (status) status.textContent = "No se pudo enviar. Escribime por email.";
    }
  });
</script>

<style>
  .mail { position: relative; padding-bottom: 0.12em; }
  .mail::after { content: ""; position: absolute; left: 0; bottom: 0; height: 0.06em; width: 100%; background: var(--color-signal); transform: scaleX(0); transform-origin: left; transition: transform 1.2s var(--ease-out-expo) 0.4s; }
  .mail.in::after, :not(.js-motion) .mail::after { transform: scaleX(1); }
  .mail:hover::after { transform-origin: right; }
  .field-wrap { display: flex; flex-direction: column; gap: 0.6rem; }
  .field { border: 0; border-bottom: 1px solid var(--color-rule); padding: 0.5rem 0; font-size: 1.1rem; background: transparent; outline: none; transition: border-color 0.3s; }
  .field:focus { border-color: var(--color-ink); }
</style>
