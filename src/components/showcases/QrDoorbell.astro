---
// QrDoorbell.astro — el QR se dibuja celda por celda y después suena el timbre en un celular
const N = 21;
// patrón pseudoaleatorio fijo + los tres cuadrados de posición de un QR real
const finder = (x: number, y: number) => {
  for (const [ox, oy] of [[0, 0], [N - 7, 0], [0, N - 7]]) {
    const dx = x - ox, dy = y - oy;
    if (dx >= 0 && dx < 7 && dy >= 0 && dy < 7) {
      const edge = dx === 0 || dx === 6 || dy === 0 || dy === 6;
      const core = dx >= 2 && dx <= 4 && dy >= 2 && dy <= 4;
      return edge || core ? 1 : 0;
    }
  }
  return -1;
};
const cells: { x: number; y: number; d: number }[] = [];
for (let y = 0; y < N; y++)
  for (let x = 0; x < N; x++) {
    const f = finder(x, y);
    const on = f === -1 ? (x * 7 + y * 13 + x * y) % 5 < 2 : f === 1;
    if (on) cells.push({ x, y, d: (x + y) * 0.035 });
  }
---

<div class="qr-sc">
  <svg class="qr" viewBox={`-1 -1 ${N + 2} ${N + 2}`} aria-hidden="true">
    <rect x="-1" y="-1" width={N + 2} height={N + 2} rx="1.2" fill="#f4f4f5" />
    {cells.map((c) => <rect class="cell" x={c.x} y={c.y} width="1" height="1" style={`--d:${c.d}s`} />)}
    <rect class="scan" x="-1" y="-1" width={N + 2} height="0.6" />
  </svg>

  <div class="phone" aria-hidden="true">
    <div class="notch"></div>
    <div class="pulse"><span></span><span></span><span></span><b>🔔</b></div>
    <div class="notif">
      <strong>Timbre</strong>
      <span>Alguien está en la puerta</span>
    </div>
  </div>
</div>

<style>
  .qr-sc {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9%;
    background: radial-gradient(70% 70% at 30% 50%, #12261f, #08090b 75%);
  }
  .qr { width: 38%; max-width: 15rem; border-radius: 0.6rem; }
  .cell { fill: #0b0b0e; opacity: 0; transform-box: fill-box; transform-origin: center; transform: scale(0.2); }
  :global(.is-on) .cell { animation: pop 0.35s var(--d) cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
  .scan { fill: #34d399; opacity: 0; }
  :global(.is-on) .scan { animation: scan 1.4s 1.5s ease-in-out forwards; }

  .phone {
    position: relative;
    width: 24%;
    max-width: 9rem;
    aspect-ratio: 9 / 18;
    border-radius: 1.4rem;
    border: 2px solid #3f3f46;
    background: #111114;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: translateY(14%);
  }
  :global(.is-on) .phone { animation: rise 0.8s 2.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .notch { position: absolute; top: 6%; width: 32%; height: 3%; border-radius: 99px; background: #27272a; }
  .pulse { position: relative; display: grid; place-items: center; width: 50%; aspect-ratio: 1; }
  .pulse b { font-size: 1.6rem; position: relative; }
  .pulse span { position: absolute; inset: 0; border-radius: 50%; border: 2px solid #34d399; opacity: 0; }
  :global(.is-on) .pulse span { animation: ring 1.8s 3.2s ease-out infinite; }
  :global(.is-on) .pulse span:nth-child(2) { animation-delay: 3.8s; }
  :global(.is-on) .pulse span:nth-child(3) { animation-delay: 4.4s; }
  :global(.is-on) .pulse b { animation: shake 0.5s 3.2s 3; }
  .notif {
    position: absolute;
    top: 13%;
    left: 7%;
    right: 7%;
    padding: 0.45rem 0.55rem;
    border-radius: 0.7rem;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(6px);
    font-size: 0.6rem;
    line-height: 1.3;
    display: flex;
    flex-direction: column;
    color: #d4d4d8;
    opacity: 0;
    transform: translateY(-40%);
  }
  .notif strong { color: #fff; }
  :global(.is-on) .notif { animation: drop 0.6s 3.1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  @keyframes pop { to { opacity: 1; transform: none; } }
  @keyframes scan { 0% { opacity: 0.8; transform: translateY(0); } 100% { opacity: 0; transform: translateY(22px); } }
  @keyframes rise { to { opacity: 1; transform: none; } }
  @keyframes drop { to { opacity: 1; transform: none; } }
  @keyframes ring { 0% { opacity: 0.8; transform: scale(0.6); } 100% { opacity: 0; transform: scale(1.8); } }
  @keyframes shake { 25% { transform: rotate(-14deg); } 75% { transform: rotate(14deg); } }
  @media (prefers-reduced-motion: reduce) {
    .cell, .phone, .notif { animation: none !important; opacity: 1; transform: none; }
  }
</style>
