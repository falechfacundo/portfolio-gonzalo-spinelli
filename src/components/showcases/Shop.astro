---
// Shop.astro — tres productos que saltan al carrito y el contador sube
import type { Project } from "../../data/portfolio";

interface Props {
  p: Project;
}
const { p } = Astro.props;
const colors = ["#e4d4c4", "#c9d3dd", "#d9d2e6"];
const prices = ["$24.900", "$18.500", "$9.900"];
const items = (p.items ?? ["Producto", "Producto", "Producto"]).slice(0, 3).map((n, i) => ({ n, p: prices[i], c: colors[i] }));
---

<div class="sh">
  <div class="bar">
    <strong>{p.title.toUpperCase()}</strong>
    <div class="cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6" /><circle cx="10" cy="20" r="1" /><circle cx="17" cy="20" r="1" /></svg>
      <span class="badge"><span class="digits">0<br />1<br />2<br />3</span></span>
    </div>
  </div>
  <div class="products">
    {
      items.map((it, i) => (
        <div class="card" style={`--i:${i}`}>
          <div class="img" style={`background:${it.c}`}>
            <span class="ghost" style={`background:${it.c}`} />
          </div>
          <div class="meta"><span>{it.n}</span><b>{it.p}</b></div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .sh {
    position: absolute;
    inset: 0;
    background: #faf9f7;
    color: #18181b;
    display: flex;
    flex-direction: column;
    padding: 5% 7%;
    gap: 6%;
  }
  .bar { display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; letter-spacing: 0.3em; }
  .cart { position: relative; width: 1.6rem; height: 1.6rem; }
  .cart svg { width: 100%; height: 100%; }
  :global(.is-on) .cart { animation: bump 0.6s 1.6s ease-out 3; }
  .badge {
    position: absolute;
    top: -0.35rem;
    right: -0.5rem;
    width: 1rem;
    height: 1rem;
    border-radius: 99px;
    background: #18181b;
    color: #fff;
    font: 600 0.6rem/1rem var(--font-mono, monospace);
    letter-spacing: 0;
    text-align: center;
    overflow: hidden;
  }
  .digits { display: block; }
  :global(.is-on) .digits { animation: count 1.8s 1s steps(3, end) forwards; }
  .products { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4%; }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    opacity: 0;
    transform: translateY(20%);
    transition: transform 0.4s;
  }
  :global(.is-on) .card { animation: up 0.7s calc(var(--i) * 0.12s) cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .card:hover { transform: perspective(500px) rotateX(6deg) rotateY(-6deg); }
  .img { position: relative; flex: 1; border-radius: 0.7rem; }
  .ghost { position: absolute; inset: 25%; border-radius: 0.5rem; opacity: 0; }
  :global(.is-on) .ghost { animation: toCart 0.75s calc(1s + var(--i) * 0.6s) cubic-bezier(0.5, 0, 0.75, 0) forwards; }
  .meta { display: flex; justify-content: space-between; font-size: 0.65rem; }

  @keyframes up { to { opacity: 1; transform: none; } }
  /* el "fantasma" del producto sale disparado hacia arriba a la derecha (el carrito) */
  @keyframes toCart {
    0% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translate(calc(220% - var(--i) * 100%), -260%) scale(0.15); }
  }
  @keyframes bump { 50% { transform: scale(1.25); } }
  @keyframes count { to { transform: translateY(-3rem); } }
  @media (prefers-reduced-motion: reduce) {
    .card { animation: none !important; opacity: 1; transform: none; }
  }
</style>
