---
// Clinic.astro — agenda semanal tranquila: los turnos se acomodan en su lugar con easing suave
const days = ["Lun", "Mar", "Mié", "Jue", "Vie"];
const slots = [
  { d: 0, r: 0, h: 2, t: "Paciente A" },
  { d: 1, r: 1, h: 1, t: "Paciente B" },
  { d: 2, r: 0, h: 1, t: "Paciente C" },
  { d: 2, r: 2, h: 2, t: "Paciente D" },
  { d: 3, r: 1, h: 2, t: "Paciente E" },
  { d: 4, r: 0, h: 1, t: "Paciente F" },
  { d: 4, r: 3, h: 1, t: "Paciente G" },
];
---

<div class="cl">
  <div class="head">
    <span class="dot"></span> Agenda · semana <span class="lock">🔒 AES-GCM · zero-knowledge</span>
  </div>
  <div class="grid">
    {days.map((d) => <span class="day">{d}</span>)}
    {Array.from({ length: 20 }, (_, i) => <span class="slot" style={`grid-column:${(i % 5) + 1};grid-row:${Math.floor(i / 5) + 2}`} />)}
    {
      slots.map((s, i) => (
        <div
          class="appt"
          style={`grid-column:${s.d + 1};grid-row:${s.r + 2} / span ${s.h};--i:${i}`}
        >
          <span class="enc">{["a9f3·e21c", "7b0d·91aa", "c44e·0f2b", "e1a8·5d6c", "3f9b·c07e", "8d21·aa4f", "0c7e·b39d"][i]}</span>
          <span class="dec">{s.t}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .cl {
    position: absolute;
    inset: 0;
    padding: 6% 7%;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    background: linear-gradient(160deg, #f3f1ea, #e6ebe3);
    color: #3f4a3c;
  }
  .head { display: flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; font-weight: 600; }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #7c9a76; }
  .grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: auto repeat(4, 1fr);
    gap: 0.35rem;
  }
  .day { grid-row: 1; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.6; }
  .slot { border-radius: 0.5rem; background: rgba(124, 154, 118, 0.08); }
  .appt {
    z-index: 1;
    border-radius: 0.55rem;
    padding: 0.35rem 0.45rem;
    font-size: 0.6rem;
    font-weight: 500;
    background: #fff;
    border-left: 3px solid #7c9a76;
    box-shadow: 0 6px 18px -8px rgba(63, 74, 60, 0.35);
    opacity: 0;
    transform: translate(-30%, -40%) rotate(-4deg);
  }
  .appt:nth-of-type(2n) { border-color: #b5a07a; }
  .appt:nth-of-type(3n) { border-color: #8aa3b5; }
  :global(.is-on) .appt {
    animation: settle 1.1s calc(0.3s + var(--i) * 0.28s) cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .lock { margin-left: auto; font: 500 0.6rem/1 var(--font-mono, monospace); opacity: 0.6; }
  .appt { display: grid; }
  .enc, .dec { grid-area: 1 / 1; }
  .enc { font-family: var(--font-mono, monospace); opacity: 0.55; }
  .dec { opacity: 0; }
  :global(.is-on) .enc { animation: out 0.4s calc(2.6s + var(--i) * 0.12s) forwards; }
  :global(.is-on) .dec { animation: inn 0.4s calc(2.75s + var(--i) * 0.12s) forwards; }
  @keyframes out { to { opacity: 0; filter: blur(3px); } }
  @keyframes inn { to { opacity: 1; } }
  @keyframes settle {
    60% { opacity: 1; transform: translate(0, 4%) rotate(0.5deg); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .appt, .dec { animation: none !important; opacity: 1; transform: none; }
    .enc { display: none; }
  }
</style>
