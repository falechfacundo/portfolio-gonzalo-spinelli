---
// Dashboard.astro — KPIs que entran, línea que se traza y barras que crecen
const kpis = [
  { l: "Visitas", v: "12.4k", d: "+18%" },
  { l: "Conversión", v: "3.2%", d: "+0.4" },
  { l: "Ingresos", v: "$8.9k", d: "+22%" },
];
const pts = [70, 62, 66, 48, 52, 38, 42, 26, 30, 14];
const line = pts.map((y, i) => `${i === 0 ? "M" : "L"}${(i * 100) / (pts.length - 1)} ${y}`).join(" ");
const bars = [40, 65, 52, 80, 58, 92, 74];
---

<div class="db">
  <div class="kpis">
    {
      kpis.map((k, i) => (
        <div class="kpi" style={`--i:${i}`}>
          <span>{k.l}</span>
          <b>{k.v}</b>
          <em>{k.d}</em>
        </div>
      ))
    }
  </div>
  <div class="charts">
    <svg class="line" viewBox="0 0 100 80" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="db-fill" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#818cf8" stop-opacity="0.35" />
          <stop offset="1" stop-color="#818cf8" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path class="area" d={`${line} L100 80 L0 80 Z`} fill="url(#db-fill)" />
      <path class="stroke" d={line} pathLength="1" />
    </svg>
    <div class="bars">
      {bars.map((h, i) => <span style={`--h:${h}%;--i:${i}`} />)}
    </div>
  </div>
</div>

<style>
  .db {
    position: absolute;
    inset: 0;
    padding: 5% 6%;
    display: flex;
    flex-direction: column;
    gap: 5%;
    background: #0e0f17;
    color: #e4e4e7;
  }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .kpi {
    display: flex;
    flex-direction: column;
    padding: 0.55rem 0.65rem;
    border-radius: 0.6rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    font-size: 0.6rem;
    opacity: 0;
    transform: translateY(30%);
  }
  .kpi b { font-size: 1.05rem; font-weight: 600; color: #fff; }
  .kpi em { font-style: normal; color: #34d399; }
  :global(.is-on) .kpi { animation: in 0.6s calc(var(--i) * 0.12s) cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .charts { flex: 1; display: grid; grid-template-columns: 1.6fr 1fr; gap: 0.6rem; min-height: 0; }
  .line, .bars {
    width: 100%;
    height: 100%;
    border-radius: 0.6rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }
  .stroke { fill: none; stroke: #818cf8; stroke-width: 1.5; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(.is-on) .stroke { animation: draw 1.8s 0.4s cubic-bezier(0.65, 0, 0.35, 1) forwards; }
  .area { opacity: 0; }
  :global(.is-on) .area { animation: fade 1s 1.6s forwards; }
  .bars { display: flex; align-items: flex-end; gap: 6%; padding: 8% 8% 0; box-sizing: border-box; }
  .bars span { flex: 1; height: var(--h); border-radius: 0.25rem 0.25rem 0 0; background: linear-gradient(#a78bfa, #6366f1); transform: scaleY(0); transform-origin: bottom; }
  :global(.is-on) .bars span { animation: grow 0.8s calc(0.5s + var(--i) * 0.08s) cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }

  @keyframes in { to { opacity: 1; transform: none; } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes grow { to { transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .kpi, .stroke, .area, .bars span { animation: none !important; opacity: 1; transform: none; stroke-dashoffset: 0; }
  }
</style>
