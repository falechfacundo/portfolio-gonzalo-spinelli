---
// Recommender.astro — tres sliders (antojo, hambre, presupuesto) se acomodan y el ranking se reordena
const sliders = [
  { l: "Antojo", v: "Pizza", from: 20, to: 72 },
  { l: "Hambre", v: "Mucha", from: 30, to: 85 },
  { l: "Presupuesto", v: "$6.000", from: 70, to: 40 },
];
// posición final en el ranking (0 = arriba) de cada resultado, en el orden del DOM
const results = [
  { n: "Grande muzza + 2 empanadas", s: "9.4", to: 0 },
  { n: "Combo burger doble", s: "8.1", to: 2 },
  { n: "Pizza mitad y mitad", s: "8.8", to: 1 },
];
---

<div class="rc">
  <div class="ctrl">
    {
      sliders.map((s, i) => (
        <div class="sl" style={`--from:${s.from}%;--to:${s.to}%;--i:${i}`}>
          <div class="lab"><span>{s.l}</span><b>{s.v}</b></div>
          <div class="track"><span class="fill" /><span class="knob" /></div>
        </div>
      ))
    }
    <span class="count">25.000+ productos analizados</span>
  </div>
  <ol class="rank">
    {
      results.map((r, i) => (
        <li style={`--from:${i};--to:${r.to}`}>
          <span>{r.n}</span><b>{r.s}</b>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .rc {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6%;
    align-items: center;
    padding: 6%;
    background: linear-gradient(150deg, #1d1208, #0c0a08 70%);
    color: #e7e5e4;
    font-size: 0.66em;
  }
  .ctrl { display: flex; flex-direction: column; gap: 0.9em; }
  .lab { display: flex; justify-content: space-between; margin-bottom: 0.35em; color: #a8a29e; }
  .lab b { color: #fdba74; font-weight: 600; }
  .track { position: relative; height: 4px; border-radius: 99px; background: rgba(255, 255, 255, 0.1); }
  .fill, .knob { position: absolute; top: 0; }
  .fill { left: 0; height: 100%; width: var(--from); border-radius: inherit; background: #fb923c; }
  .knob { left: var(--from); width: 12px; height: 12px; margin: -4px 0 0 -6px; border-radius: 50%; background: #fff; }
  :global(.is-on) .fill { animation: w 1.2s calc(0.3s + var(--i) * 0.2s) cubic-bezier(0.65, 0, 0.35, 1) forwards; }
  :global(.is-on) .knob { animation: l 1.2s calc(0.3s + var(--i) * 0.2s) cubic-bezier(0.65, 0, 0.35, 1) forwards; }
  .count { font-family: var(--font-mono, monospace); color: #78716c; }

  .rank { position: relative; height: 9.6em; margin: 0; padding: 0; list-style: none; }
  .rank li {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--from) * 3.2em);
    height: 2.7em;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.8em;
    border-radius: 0.6em;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .rank b { font-family: var(--font-mono, monospace); color: #fdba74; }
  :global(.is-on) .rank li { animation: move 0.9s 1.8s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  :global(.is-on) .rank li[style*="--to:0"] { border-color: rgba(251, 146, 60, 0.6); }

  @keyframes w { to { width: var(--to); } }
  @keyframes l { to { left: var(--to); } }
  @keyframes move { to { top: calc(var(--to) * 3.2em); } }
  @media (prefers-reduced-motion: reduce) {
    .fill { width: var(--to); } .knob { left: var(--to); } .rank li { top: calc(var(--to) * 3.2em); }
    .fill, .knob, .rank li { animation: none !important; }
  }
</style>
