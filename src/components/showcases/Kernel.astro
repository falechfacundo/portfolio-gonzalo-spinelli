---
// Kernel.astro — log de arranque que avanza línea por línea y un radar Wi-Fi que barre redes
const log = [
  ["ok", "make ARCH=arm64 samsung_defconfig"],
  ["ok", "CC  drivers/net/wireless/ath9k_htc"],
  ["ok", "LD  vmlinux · Image.gz-dtb"],
  ["err", "boot: verificación fallida · TrustZone"],
  ["dim", "→ analizando last_kmsg…"],
  ["dim", "→ clave de cifrado atada al arranque"],
  ["ok", "drivers built-in · sin módulos firmados"],
  ["ok", "kernel 4.14-nethunter · arrancó"],
];
const nets = [
  { x: 28, y: 30, d: 0 },
  { x: 70, y: 22, d: 0.6 },
  { x: 62, y: 70, d: 1.2 },
  { x: 22, y: 66, d: 1.8 },
];
---

<div class="kn">
  <div class="log">
    {
      log.map(([k, t], i) => (
        <div class={`ln ${k}`} style={`--i:${i}`}>
          <span>{k === "err" ? "✗" : k === "ok" ? "✓" : " "}</span> {t}
        </div>
      ))
    }
    <div class="ln root" style={`--i:${log.length}`}>root@nethunter:~# <span class="cur">▍</span></div>
  </div>
  <div class="radar" aria-hidden="true">
    <span class="sweep"></span>
    {nets.map((n) => <i style={`left:${n.x}%;top:${n.y}%;--d:${n.d}s`} />)}
  </div>
</div>

<style>
  .kn {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    gap: 5%;
    padding: 6%;
    background: radial-gradient(80% 80% at 80% 50%, #0b1a14, #050607 70%);
    font: 0.66rem/1.65 var(--font-mono, monospace);
    color: #a1a1aa;
  }
  .ln { white-space: nowrap; overflow: hidden; opacity: 0; transform: translateX(-6px); }
  .ln span { display: inline-block; width: 1em; }
  .ok span { color: #34d399; }
  .err { color: #f87171; }
  .dim { color: #71717a; }
  .root { color: #34d399; }
  .cur { animation: blink 1s step-end infinite; }
  :global(.is-on) .ln { animation: line 0.3s calc(0.25s + var(--i) * 0.38s) ease-out forwards; }
  .radar {
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(52, 211, 153, 0.35);
    background: repeating-radial-gradient(circle, transparent 0 18%, rgba(52, 211, 153, 0.12) 18% calc(18% + 1px));
    overflow: hidden;
  }
  .sweep {
    position: absolute;
    inset: 0;
    background: conic-gradient(from 0deg, rgba(52, 211, 153, 0.45), transparent 25%);
    animation: spin 3s linear infinite;
  }
  .radar i {
    position: absolute;
    width: 7px;
    height: 7px;
    margin: -3px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 10px #34d399;
    opacity: 0;
  }
  :global(.is-on) .radar i { animation: ping 3s var(--d) ease-out infinite; }

  @keyframes line { to { opacity: 1; transform: none; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes ping { 0%, 100% { opacity: 0; } 10% { opacity: 1; } 60% { opacity: 0.2; } }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .ln { animation: none !important; opacity: 1; transform: none; }
    .sweep { animation: none; }
  }
</style>
