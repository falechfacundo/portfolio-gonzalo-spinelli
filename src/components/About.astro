---
// About.astro
const statement =
  "No me detengo en el casi funciona. Diagnostico sobre evidencia real (logs, volcados de memoria, bytes) hasta dar con la causa raíz, y entrego algo que anda de verdad.";

const pillars = [
  {
    k: "01",
    t: "Bajo nivel",
    d: "C, kernel Linux y seguridad de dispositivos: compilar, revertir formatos binarios y entender el arranque del hardware.",
  },
  {
    k: "02",
    t: "Producto en producción",
    d: "Web y PWAs livianas, criptografía aplicada (zero-knowledge, E2E) y un motor separado de la interfaz por contratos de API limpios.",
  },
  {
    k: "03",
    t: "IA en hardware propio",
    d: "Pipelines de IA generativa 3D y video corriendo localmente, sin costos de nube.",
  },
];
---

<section id="about" class="section">
  <div class="wrap">
    <span class="eyebrow" data-reveal>Sobre mí</span>
    <p
      data-words
      class="mt-6 max-w-[62rem] text-[clamp(1.6rem,3.6vw,3rem)] font-medium leading-[1.18] tracking-[-0.03em] text-white"
    >
      {
        statement.split(" ").map((w) => (
          <span class="w inline-block whitespace-pre">{w} </span>
        ))
      }
    </p>

    <div class="mt-16 grid gap-4 md:grid-cols-3">
      {
        pillars.map((p) => (
          <article data-reveal class="spot glass rounded-3xl p-7">
            <span class="font-mono text-xs text-accent-2">{p.k}</span>
            <h3 class="mt-10 text-xl font-semibold tracking-tight text-white">{p.t}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-fg-2">{p.d}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
