---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { site } from "../data/portfolio";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} · ${site.role}`,
  description = `${site.name}: construyo productos con IA, de mods 3D a sistemas conectados y webapps para profesionales.`,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/ico" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0b0e" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js-motion");
        // safety net: if motion.ts hasn't run yet (slow network / blocked script), show the content
        setTimeout(() => {
          if (!document.documentElement.dataset.motion)
            document.documentElement.classList.remove("js-motion");
        }, 3000);
      }
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
      >Saltar al contenido</a
    >
    <div
      id="progress"
      class="fixed inset-x-0 top-0 z-[60] h-[2px] origin-left scale-x-0 bg-gradient-to-r from-accent via-accent-2 to-accent-3"
      aria-hidden="true"
    >
    </div>
    <div
      id="cursor-glow"
      class="pointer-events-none fixed left-0 top-0 z-0 hidden h-[34rem] w-[34rem] rounded-full opacity-0 [background:radial-gradient(closest-side,rgba(110,92,245,0.13),transparent)] lg:block"
      aria-hidden="true"
    >
    </div>
    <Header />
    <main id="main" class="relative z-[1] outline-none"><slot /></main>
    <Footer />
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
