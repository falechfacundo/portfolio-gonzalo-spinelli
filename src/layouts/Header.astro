---
// Header.astro — barra blanca mínima: nombre, sección actual con contador, contacto
import { site } from "../data/portfolio";

const links = [
  { href: "#index", label: "Proyectos" },
  { href: "#capabilities", label: "Capacidades" },
  { href: "#contact", label: "Contacto" },
];
---

<header id="nav" class="fixed inset-x-0 top-0 z-50 transition-[background,box-shadow,color] duration-500">
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a href="#top" class="text-[0.95rem] font-semibold tracking-tight">{site.shortName}</a>

    <!-- contador de capítulo: lo actualiza motion.ts -->
    <div class="label hidden items-center gap-3 md:flex" aria-hidden="true">
      <span data-nav-section>Inicio</span>
      <span class="h-px w-10 bg-current opacity-30"></span>
      <span data-nav-count class="tabular-nums">00 / 00</span>
    </div>

    <nav aria-label="Principal" class="flex items-center gap-1">
      {
        links.map((l) => (
          <a href={l.href} class="hidden rounded-full px-3.5 py-2 text-[0.88rem] opacity-70 transition-opacity hover:opacity-100 sm:block">
            {l.label}
          </a>
        ))
      }
      <a href="#contact" class="btn ml-2 !h-9 !px-4 text-[0.85rem] sm:hidden">Contacto</a>
    </nav>
  </div>
  <div class="absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 bg-current opacity-20" data-nav-progress></div>
</header>

<style>
  #nav.is-stuck { background: color-mix(in srgb, var(--nav-bg, #fff) 82%, transparent); backdrop-filter: saturate(1.6) blur(18px); }
  #nav.on-dark { color: #f5f5f7; --nav-bg: #000; }
  #nav.on-dark .btn { background: #f5f5f7; color: #000; }
</style>
