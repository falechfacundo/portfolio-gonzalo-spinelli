---
// Header.astro — floating pill nav with scroll-spy
const links = [
  { href: "#home", label: "Inicio" },
  { href: "#about", label: "Sobre mí" },
  { href: "#skills", label: "Skills" },
  { href: "#projects", label: "Proyectos" },
  { href: "#contact", label: "Contacto" },
];
---

<header class="fixed inset-x-0 top-4 z-50 flex justify-center px-4" id="nav">
  <nav
    class="nav-pill glass flex items-center gap-1 rounded-full p-1.5 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.8)] transition-[background,box-shadow] duration-500"
    aria-label="Principal"
  >
    <ul class="flex items-center gap-0.5">
      {
        links.map((l) => (
          <li class={["#home", "#projects", "#contact"].includes(l.href) ? "" : "hidden sm:block"}>
            <a
              href={l.href}
              data-spy={l.href}
              class="relative rounded-full px-2 py-2 min-[360px]:px-3.5 text-[0.85rem] after:absolute after:inset-x-0 after:-inset-y-1.5 text-fg-2 transition-colors hover:text-white data-[active=true]:bg-white/10 data-[active=true]:text-white"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="#contact"
      class="btn btn-primary btn-sm ml-1"
      data-magnetic
    >
      Hablemos
    </a>
  </nav>
</header>

<style>
  .nav-pill::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }
  :global(#nav.is-stuck) .nav-pill {
    background: rgba(11, 11, 14, 0.72);
  }
</style>
